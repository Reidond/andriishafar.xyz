---
import resume from "../../data/resume.json";

const { profile, projects, publications, socialLinks } = resume;

const work = [
  { name: "Charidy", role: "Fundraising platform", years: "2020–now" },
  { name: "SapienLabs", role: "Research platforms", years: "2026–now" },
  { name: "Lemmi", role: "AI interviewing", years: "2026" },
  { name: "Uzhhorod National University", role: "Postgraduate research", years: "" },
];

const projectLines: Record<string, string> = {
  "Tourism Risk Platform": "Travel-safety risk analysis",
  Stavka: "LLM opponent for Arma Reforger",
  bwssh: "Bitwarden-backed SSH agent",
  "Open-source tools": "Themes, components, CLIs",
};

const links = socialLinks.filter((link) => ["GitHub", "Bluesky", "X", "ORCID"].includes(link.label));
const tabs = ["Hello", "Work", "Projects", "Papers", "Contact"];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ebeae6" />
    <title>Andrii Shafar</title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Crect width='16' height='16' rx='4' fill='%23161616'/%3E%3C/svg%3E" />
  </head>
  <body>
    <main class="stage">
      <div class="deck" data-deck>
        <article class="card" id="card-0" role="tabpanel" aria-labelledby="tab-0" style="--i: 0">
          <div class="card-body hello">
            <img class="photo" src="/andrii-shafar.jpg" alt="Andrii Shafar" width="460" height="460" draggable="false" />
            <div class="hello-text">
              <h1>{profile.name}</h1>
              <p>Software engineer &amp; applied researcher</p>
            </div>
          </div>
        </article>

        <article class="card" id="card-1" role="tabpanel" aria-labelledby="tab-1" style="--i: 1">
          <div class="card-body">
            <h2>Work</h2>
            <ul class="rows">
              {work.map((item) => (
                <li class="row">
                  <span class="row-text">
                    <span class="row-main">{item.name}</span>
                    <span class="row-sub">{item.role}</span>
                  </span>
                  <span class="row-end">{item.years}</span>
                </li>
              ))}
            </ul>
          </div>
        </article>

        <article class="card" id="card-2" role="tabpanel" aria-labelledby="tab-2" style="--i: 2">
          <div class="card-body">
            <h2>Projects</h2>
            <ul class="rows">
              {projects.map((project) => (
                <li>
                  <a class="row" href={project.href} target="_blank" rel="noreferrer">
                    <span class="row-text">
                      <span class="row-main">{project.name}</span>
                      <span class="row-sub">{projectLines[project.name]}</span>
                    </span>
                    <svg class="row-arrow" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5" /></svg>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </article>

        <article class="card" id="card-3" role="tabpanel" aria-labelledby="tab-3" style="--i: 3">
          <div class="card-body">
            <h2>Papers</h2>
            <ul class="rows">
              {publications.map((paper) => (
                <li>
                  <a class="row row-paper" href={paper.href} target="_blank" rel="noreferrer">
                    <span class="row-main">{paper.title}</span>
                    <span class="row-end">{paper.year}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </article>

        <article class="card" id="card-4" role="tabpanel" aria-labelledby="tab-4" style="--i: 4">
          <div class="card-body contact">
            <h2>Contact</h2>
            <button class="email" type="button" data-copy={profile.email}>
              <span>{profile.email}</span>
              <span class="email-icon" aria-hidden="true">
                <svg class="icon-copy" viewBox="0 0 16 16" width="16" height="16">
                  <rect x="5.5" y="5.5" width="8" height="8" rx="1.5" />
                  <path d="M10.5 3.5v-.5A1.5 1.5 0 0 0 9 1.5H4A1.5 1.5 0 0 0 2.5 3v5A1.5 1.5 0 0 0 4 9.5h.5" />
                </svg>
                <svg class="icon-check" viewBox="0 0 16 16" width="16" height="16"><path d="m3.5 8.5 3 3 6-7" /></svg>
              </span>
            </button>
            <span class="sr-only" aria-live="polite" data-status></span>
            <ul class="rows">
              {links.map((link) => (
                <li>
                  <a class="row" href={link.href} target="_blank" rel="noreferrer">
                    <span class="row-main">{link.label}</span>
                    <span class="row-end">{link.handle}</span>
                  </a>
                </li>
              ))}
            </ul>
            <a class="resume" href="/andrii-shafar-resume.pdf" download>
              Résumé PDF
              <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M8 2.5v8M4.5 7 8 10.5 11.5 7M3 13.5h10" /></svg>
            </a>
          </div>
        </article>
      </div>

      <div class="tabs">
        <div class="tabs-list" role="tablist" aria-label="Sections">
          {tabs.map((tab, index) => (
            <button
              class="tab"
              id={`tab-${index}`}
              role="tab"
              type="button"
              aria-controls={`card-${index}`}
              aria-selected={index === 0 ? "true" : "false"}
              tabindex={index === 0 ? 0 : -1}
              data-tab={index}
            >
              {tab}
            </button>
          ))}
        </div>
        <div class="tabs-list tabs-active" aria-hidden="true" data-active>
          {tabs.map((tab) => <span class="tab">{tab}</span>)}
        </div>
      </div>
    </main>

    <style is:global>
      :root {
        --bg: #ebeae6;
        --card: #fff;
        --ink: #161616;
        --muted: #6b6b6b;
        --rule: rgb(0 0 0 / 0.07);
        --card-w: min(400px, calc(100vw - 40px));
        --card-h: calc(var(--card-w) + 104px);
        --radius: 28px;
        --pad: 12px;
        --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
        --ease-drawer: cubic-bezier(0.32, 0.72, 0, 1);
        --icon-ease: cubic-bezier(0.2, 0, 0, 1);
        --font: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", Inter, sans-serif;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100svh;
        background: var(--bg);
        color: var(--ink);
        font: 400 15px/1.45 var(--font);
        -webkit-font-smoothing: antialiased;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      :focus-visible {
        outline: 2px solid var(--ink);
        outline-offset: 2px;
      }

      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
      }

      .stage {
        min-height: 100svh;
        display: grid;
        place-content: center;
        justify-items: center;
        gap: 40px;
        padding: 72px 20px 48px;
      }

      /* Deck */
      .deck {
        position: relative;
        width: var(--card-w);
        height: var(--card-h);
        touch-action: pan-y;
      }

      .card {
        position: absolute;
        inset: 0;
        border-radius: var(--radius);
        background: var(--card);
        box-shadow:
          0 0 0 1px rgb(0 0 0 / 0.04),
          0 1px 2px rgb(0 0 0 / 0.04),
          0 6px 12px -4px rgb(0 0 0 / 0.06),
          0 24px 40px -12px rgb(0 0 0 / 0.1);
        transform-origin: 50% 0;
        user-select: none;
        transition-property: transform, opacity;
        transition-duration: 520ms;
        transition-timing-function: var(--ease-drawer);
        animation: deal 700ms var(--ease-out) backwards;
        animation-delay: calc(var(--i) * 70ms);
      }

      .card[data-depth="0"] {
        cursor: grab;
      }

      .card[data-dragging] {
        cursor: grabbing;
        transition-duration: 0ms;
      }

      .deck[data-instant] .card {
        transition-duration: 0ms;
      }

      .card-body {
        height: 100%;
        padding: 24px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        transition-property: opacity;
        transition-duration: 200ms;
        transition-timing-function: ease;
      }

      .card:not([data-depth="0"]) .card-body {
        opacity: 0;
      }

      /* Hello */
      .hello {
        padding: var(--pad);
      }

      .photo {
        display: block;
        width: 100%;
        aspect-ratio: 1;
        object-fit: cover;
        border-radius: calc(var(--radius) - var(--pad));
        outline: 1px solid oklch(0 0 0 / 0.1);
        outline-offset: -1px;
        pointer-events: none;
      }

      .hello-text {
        flex: 1;
        display: grid;
        align-content: center;
        gap: 2px;
        padding: 0 12px;
      }

      h1 {
        margin: 0;
        font-size: 20px;
        font-weight: 600;
        letter-spacing: -0.015em;
      }

      .hello-text p {
        margin: 0;
        color: var(--muted);
      }

      h2 {
        margin: 0 0 12px;
        color: var(--muted);
        font-size: 13px;
        font-weight: 500;
      }

      /* Rows */
      .rows {
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .rows li + li {
        border-top: 1px solid var(--rule);
      }

      .row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        min-height: 64px;
        padding: 12px 0;
      }

      .row-text {
        display: grid;
        gap: 1px;
        min-width: 0;
      }

      .row-main {
        font-weight: 500;
        text-wrap: pretty;
      }

      .row-sub,
      .row-end {
        color: var(--muted);
      }

      .row-end {
        flex-shrink: 0;
        font-size: 13px;
        font-variant-numeric: tabular-nums;
      }

      .row-paper {
        align-items: baseline;
        min-height: 0;
        padding: 14px 0;
        font-size: 14px;
        line-height: 1.4;
      }

      .row-paper .row-main {
        font-weight: 400;
      }

      .row-arrow,
      .resume svg {
        flex-shrink: 0;
        fill: none;
        stroke: currentColor;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      .row-arrow {
        color: var(--muted);
        transition-property: transform, color;
        transition-duration: 150ms;
        transition-timing-function: var(--ease-out);
      }

      a.row {
        transition-property: opacity;
        transition-duration: 120ms;
      }

      /* Contact */
      .contact .rows {
        margin-top: 8px;
      }

      .contact .row {
        min-height: 48px;
        padding: 8px 0;
      }

      .email {
        display: inline-flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        width: calc(100% + 24px);
        min-height: 56px;
        margin: 0 -12px;
        padding: 0 12px;
        border: 0;
        border-radius: 12px;
        background: transparent;
        color: var(--ink);
        font: 600 clamp(18px, 5.2vw, 22px) / 1.2 var(--font);
        letter-spacing: -0.02em;
        cursor: pointer;
        transition-property: background-color, transform;
        transition-duration: 120ms, 160ms;
        transition-timing-function: ease, var(--ease-out);
      }

      .email:active,
      .resume:active,
      .tab:active {
        transform: scale(0.96);
      }

      .email-icon {
        position: relative;
        width: 18px;
        height: 18px;
        color: var(--muted);
      }

      .email-icon svg {
        position: absolute;
        inset: 0;
        width: 18px;
        height: 18px;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.75;
        stroke-linecap: round;
        stroke-linejoin: round;
        transition-property: opacity, scale, filter;
        transition-duration: 200ms;
        transition-timing-function: var(--icon-ease);
      }

      .icon-check {
        opacity: 0;
        scale: 0.25;
        filter: blur(4px);
      }

      .email[data-copied] .icon-copy {
        opacity: 0;
        scale: 0.25;
        filter: blur(4px);
      }

      .email[data-copied] .icon-check {
        opacity: 1;
        scale: 1;
        filter: blur(0);
        color: var(--ink);
      }

      .resume {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        height: 48px;
        margin: auto -12px -12px;
        border-radius: calc(var(--radius) - var(--pad));
        background: var(--ink);
        color: #fff;
        font-weight: 600;
        transition-property: transform, background-color;
        transition-duration: 160ms, 120ms;
        transition-timing-function: var(--ease-out), ease;
      }

      /* Tabs */
      .tabs {
        position: relative;
        padding: 4px;
        border-radius: 999px;
        background: rgb(0 0 0 / 0.05);
      }

      .tabs-list {
        display: flex;
      }

      .tab {
        display: grid;
        place-items: center;
        height: 36px;
        padding: 0 14px;
        border: 0;
        border-radius: 999px;
        background: transparent;
        color: var(--muted);
        font: 500 14px/1 var(--font);
        white-space: nowrap;
        cursor: pointer;
        transition-property: transform, color;
        transition-duration: 160ms, 120ms;
        transition-timing-function: var(--ease-out), ease;
      }

      .tabs-active {
        position: absolute;
        inset: 4px;
        pointer-events: none;
        clip-path: inset(0 100% 0 0 round 999px);
        transition-property: clip-path;
        transition-duration: 260ms;
        transition-timing-function: var(--ease-out);
      }

      .tabs-active .tab {
        border-radius: 0;
        background: var(--card);
        color: var(--ink);
      }

      .tabs[data-instant] .tabs-active {
        transition-duration: 0ms;
      }

      @media (hover: hover) and (pointer: fine) {
        .tab:hover {
          color: var(--ink);
        }

        .rows:has(a.row:hover) a.row:not(:hover) {
          opacity: 0.45;
        }

        a.row:hover .row-arrow {
          color: var(--ink);
          transform: translate(2px, -2px);
        }

        .email:hover {
          background: rgb(0 0 0 / 0.04);
        }

        .resume:hover {
          background: #2a2a2a;
        }
      }

      @keyframes deal {
        from {
          opacity: 0;
          translate: 0 32px;
        }
      }

      @media (max-width: 420px) {
        .tab {
          padding: 0 10px;
          font-size: 13px;
        }

        .card-body {
          padding: 20px;
        }

        .hello {
          padding: var(--pad);
        }

        .row-paper {
          padding: 10px 0;
          font-size: 13px;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .card {
          transition-property: opacity;
          animation-name: deal-fade;
        }

        @keyframes deal-fade {
          from {
            opacity: 0;
          }
        }
      }
    </style>

    <script>
      const deck = document.querySelector<HTMLElement>("[data-deck]")!;
      const cards = [...deck.querySelectorAll<HTMLElement>(".card")];
      const tabsRoot = document.querySelector<HTMLElement>(".tabs")!;
      const tabs = [...document.querySelectorAll<HTMLButtonElement>("[data-tab]")];
      const active = document.querySelector<HTMLElement>("[data-active]")!;
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      let order = cards.map((_, index) => index);
      let peek = false;

      function stackTransform(depth: number) {
        const step = peek ? 22 : 14;
        const shrink = peek ? 0.04 : 0.05;
        if (reduceMotion) return "none";
        return `translateY(${-depth * step}px) scale(${1 - depth * shrink})`;
      }

      function render() {
        order.forEach((cardIndex, depth) => {
          const card = cards[cardIndex];
          card.dataset.depth = String(depth);
          card.style.zIndex = String(cards.length - depth);
          card.style.transform = stackTransform(depth);
          card.style.opacity = depth > 2 ? "0" : reduceMotion && depth > 0 ? "0" : "1";
          card.inert = depth !== 0;
        });

        const current = order[0];
        tabs.forEach((tab, index) => {
          const selected = index === current;
          tab.setAttribute("aria-selected", String(selected));
          tab.tabIndex = selected ? 0 : -1;
        });

        const tab = tabs[current];
        const left = tab.offsetLeft - active.offsetLeft;
        const right = active.offsetWidth - (left + tab.offsetWidth);
        active.style.clipPath = `inset(0 ${right}px 0 ${left}px round 999px)`;
      }

      function show(index: number, instant = false) {
        const position = order.indexOf(index);
        if (position <= 0) return;
        order = [...order.slice(position), ...order.slice(0, position)];
        deck.toggleAttribute("data-instant", instant);
        tabsRoot.toggleAttribute("data-instant", instant);
        render();
        if (instant) {
          requestAnimationFrame(() => {
            deck.removeAttribute("data-instant");
            tabsRoot.removeAttribute("data-instant");
          });
        }
      }

      tabs.forEach((tab, index) => {
        tab.addEventListener("click", () => show(index));
        tab.addEventListener("keydown", (event) => {
          const keys: Record<string, number> = {
            ArrowRight: (index + 1) % tabs.length,
            ArrowLeft: (index - 1 + tabs.length) % tabs.length,
            Home: 0,
            End: tabs.length - 1,
          };
          if (!(event.key in keys)) return;
          event.preventDefault();
          const next = keys[event.key];
          show(next, true);
          tabs[next].focus();
        });
      });

      deck.addEventListener("pointerenter", (event) => {
        if (event.pointerType !== "mouse") return;
        peek = true;
        render();
      });

      deck.addEventListener("pointerleave", () => {
        peek = false;
        render();
      });

      // Swipe the front card away (mouse, touch or trackpad) to send it to the back of the deck.
      const DISTANCE = 110;
      const VELOCITY = 0.11;

      function follow(card: HTMLElement, dx: number) {
        card.setAttribute("data-dragging", "");
        card.style.transform = `translateX(${dx}px) rotate(${dx * 0.04}deg)`;
      }

      function dismiss(card: HTMLElement, direction: number) {
        card.removeAttribute("data-dragging");
        card.style.transitionDuration = "180ms";
        card.style.transitionTimingFunction = "ease-out";
        card.style.transform = `translateX(${direction * deck.offsetWidth * 0.75}px) rotate(${direction * 6}deg)`;
        window.setTimeout(() => {
          card.style.transitionDuration = "";
          card.style.transitionTimingFunction = "";
          show(order[1]);
        }, 170);
      }

      function settle(card: HTMLElement) {
        card.removeAttribute("data-dragging");
        render();
      }

      let drag: { id: number; card: HTMLElement; x: number; y: number; time: number; dx: number; active: boolean } | null =
        null;
      let suppressClick = false;

      deck.addEventListener("pointerdown", (event) => {
        if (drag || !event.isPrimary || event.button !== 0) return;
        const card = (event.target as HTMLElement).closest<HTMLElement>(".card");
        if (!card || card.dataset.depth !== "0") return;
        drag = { id: event.pointerId, card, x: event.clientX, y: event.clientY, time: 0, dx: 0, active: false };
      });

      deck.addEventListener("pointermove", (event) => {
        if (!drag || event.pointerId !== drag.id) return;
        const dx = event.clientX - drag.x;
        const dy = event.clientY - drag.y;
        if (!drag.active) {
          if (Math.abs(dy) > 8 && Math.abs(dy) > Math.abs(dx)) {
            drag = null;
            return;
          }
          if (Math.abs(dx) < 6) return;
          drag.active = true;
          drag.time = performance.now();
          drag.card.setPointerCapture(event.pointerId);
        }
        drag.dx = dx;
        follow(drag.card, dx);
      });

      function release(event: PointerEvent) {
        if (!drag || event.pointerId !== drag.id) return;
        const { card, dx, time, active } = drag;
        drag = null;
        if (!active) return;
        suppressClick = true;
        window.setTimeout(() => (suppressClick = false), 0);

        const velocity = Math.abs(dx) / Math.max(1, performance.now() - time);
        if (event.type !== "pointercancel" && (Math.abs(dx) > DISTANCE || (velocity > VELOCITY && Math.abs(dx) > 24))) {
          dismiss(card, Math.sign(dx));
        } else {
          settle(card);
        }
      }

      deck.addEventListener("pointerup", release);
      deck.addEventListener("pointercancel", release);
      deck.addEventListener("dragstart", (event) => event.preventDefault());
      deck.addEventListener(
        "click",
        (event) => {
          if (!suppressClick) return;
          event.preventDefault();
          event.stopPropagation();
        },
        true,
      );

      // Two-finger horizontal swipe on a trackpad arrives as wheel events with deltaX.
      const wheel = { dx: 0, idle: 0, locked: false, unlock: 0 };

      deck.addEventListener(
        "wheel",
        (event) => {
          if (Math.abs(event.deltaX) <= Math.abs(event.deltaY)) return;
          event.preventDefault();

          // Swallow the momentum tail of a swipe that already dismissed a card.
          if (wheel.locked) {
            clearTimeout(wheel.unlock);
            wheel.unlock = window.setTimeout(() => (wheel.locked = false), 180);
            return;
          }

          const card = cards[order[0]];
          wheel.dx -= event.deltaX;
          follow(card, wheel.dx);

          clearTimeout(wheel.idle);
          if (Math.abs(wheel.dx) > DISTANCE) {
            dismiss(card, Math.sign(wheel.dx));
            wheel.dx = 0;
            wheel.locked = true;
            wheel.unlock = window.setTimeout(() => (wheel.locked = false), 180);
            return;
          }

          wheel.idle = window.setTimeout(() => {
            wheel.dx = 0;
            settle(card);
          }, 140);
        },
        { passive: false },
      );

      document.addEventListener("keydown", (event) => {
        if (event.target instanceof HTMLButtonElement) return;
        if (event.key === "ArrowRight") show(order[1], true);
        if (event.key === "ArrowLeft") show(order[order.length - 1], true);
      });

      window.addEventListener("resize", render);
      render();

      // One-time hint that the front card can be dragged.
      let touched = false;
      deck.addEventListener("pointerdown", () => (touched = true), { once: true });
      if (!reduceMotion) {
        window.setTimeout(() => {
          if (touched || order[0] !== 0) return;
          cards[0].animate(
            [
              { translate: "0 0", rotate: "0deg" },
              { translate: "18px 0", rotate: "1.5deg" },
              { translate: "0 0", rotate: "0deg" },
            ],
            { duration: 900, easing: "cubic-bezier(0.77, 0, 0.175, 1)" },
          );
        }, 1400);
      }

      const email = document.querySelector<HTMLButtonElement>("[data-copy]")!;
      const status = document.querySelector<HTMLElement>("[data-status]")!;
      let reset = 0;

      email.addEventListener("click", async () => {
        await navigator.clipboard.writeText(email.dataset.copy!);
        email.setAttribute("data-copied", "");
        status.textContent = "Email copied";
        clearTimeout(reset);
        reset = window.setTimeout(() => {
          email.removeAttribute("data-copied");
          status.textContent = "";
        }, 1600);
      });
    </script>
  </body>
</html>
