---
import Layout from "../layouts/Layout.astro";

const socialLinks = [
  { label: "GitHub", handle: "@Reidond", href: "https://github.com/Reidond" },
  { label: "GitLab", handle: "@Reidond", href: "https://gitlab.com/Reidond" },
  { label: "ORCID", handle: "0009-0004-2445-8232", href: "https://orcid.org/0009-0004-2445-8232" },
  { label: "Bluesky", handle: "@andriishafar.xyz", href: "https://bsky.app/profile/andriishafar.xyz" },
  { label: "X", handle: "@reidond69", href: "https://x.com/reidond69" },
  { label: "Instagram", handle: "@andriishafar", href: "https://instagram.com/andriishafar" },
  { label: "PyPI", handle: "andriishafar", href: "https://pypi.org/user/andriishafar/" },
];

const projects = [
  {
    index: "01",
    name: "Tourism Risk Platform",
    description:
      "An intelligent analytical system for evaluating travel-safety risk across individual, regional, and national levels.",
    stack: "Python · Fuzzy systems · Decision support",
    href: "https://github.com/Reidond/travel-risk-platform",
  },
  {
    index: "02",
    name: "Stavka",
    description:
      "An LLM-powered strategic orchestration layer that drives a dynamic AI opponent inside Arma Reforger.",
    stack: "TypeScript · LLM agents · Game systems",
    href: "https://reforger.armaplatform.com/workshop/68B1A0F0C0DE0001",
  },
  {
    index: "03",
    name: "bwssh",
    description:
      "A Bitwarden-backed SSH agent built to keep key access convenient without loosening the security model.",
    stack: "Python · SSH · Security tooling",
    href: "https://pypi.org/project/bwssh/",
  },
  {
    index: "04",
    name: "Open-source tools",
    description:
      "Developer utilities and experiments spanning terminal themes, Vue components, editor tooling, Rust, Go, and native apps.",
    stack: "115 public repositories · GitHub since 2016",
    href: "https://github.com/Reidond?tab=repositories",
  },
];

const publications = [
  {
    year: "2025",
    title: "Intellectual-analytical platform for assessing the security risk of tourist travel",
    journal: "Scientific Journal of the Ternopil National Technical University, 120(4)",
    href: "https://doi.org/10.33108/visnyk_tntu2025.04.078",
  },
  {
    year: "2025",
    title: "Model of expert assessment of the level of influence of human resources on tourist satisfaction with the destination",
    journal: "Herald of Khmelnytskyi National University. Technical Sciences, 349(2)",
    href: "https://doi.org/10.31891/2307-5732-2025-349-69",
  },
  {
    year: "2024",
    title: "A neuro-fuzzy model for destination evaluation and choice taking into account the target needs of the tourist",
    journal: "Computer Science and Applied Mathematics",
    href: "https://doi.org/10.26661/2786-6254-2024-2-02",
  },
  {
    year: "2024",
    title: "Informational and analytical model for assessing the level of tourist satisfaction with accommodation facilities",
    journal: "Management of Development of Complex Systems, 57",
    href: "https://doi.org/10.32347/2412-9933.2024.57.164-173",
  },
];

const capabilities = [
  "Product engineering",
  "Frontend systems",
  "TypeScript & JavaScript",
  "Python",
  "Go",
  "Rust",
  "AI agents",
  "Fuzzy logic",
  "Decision-support models",
  "Developer tooling",
  "Cloud platforms",
  "Research engineering",
];

---

<Layout
  title="Andrii Shafar — Software Engineer & Applied Researcher"
  description="The professional portfolio of Andrii Shafar: software engineering, open-source work, applied AI research, and publications."
>
    <main>
      <nav class="site-nav" aria-label="Primary navigation">
        <a class="wordmark" href="#top" aria-label="Andrii Shafar, home">
          AS<span class="wordmark-dot">.</span>
        </a>
        <div class="nav-links">
          <a href="#work">Work</a>
          <a href="#research">Research</a>
          <a href="#connect">Connect</a>
        </div>
        <a class="nav-cta" href="mailto:andreyshafar@gmail.com">
          Let&apos;s talk <span aria-hidden="true">↗</span>
        </a>
      </nav>

      <section class="hero" id="top">
        <div class="hero-intro">
          <p class="eyebrow"><span class="status-dot" /> Based in Ukraine · Open to meaningful work</p>
          <h1>
            Software engineer.
            <br />
            Applied researcher.
            <br />
            <span>System thinker.</span>
          </h1>
          <p class="hero-copy">
            I&apos;m Andrii Shafar. I build practical software across the stack and research intelligent
            decision-support systems that turn ambiguity into useful, human-scale answers.
          </p>
          <div class="hero-actions">
            <a class="button button-dark" href="#work">Explore selected work <span aria-hidden="true">↓</span></a>
            <a class="text-link" href="https://github.com/Reidond" target="_blank" rel="noreferrer">
              GitHub profile <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>

        <div class="portrait-wrap">
          <div class="portrait-frame">
            <img src="/andrii-shafar.jpg" alt="Andrii Shafar" />
            <div class="portrait-caption">
              <span>Andrii Shafar</span>
              <span>Engineer / Researcher</span>
            </div>
          </div>
          <div class="portrait-note" aria-hidden="true">
            <span>BUILD</span>
            <span>RESEARCH</span>
            <span>REFINE</span>
          </div>
        </div>

        <div class="hero-metrics" aria-label="Professional highlights">
          <div><strong>10</strong><span>years of public<br />building on GitHub</span></div>
          <div><strong>115</strong><span>public software<br />repositories</span></div>
          <div><strong>4</strong><span>selected peer-reviewed<br />publications</span></div>
        </div>
      </section>

      <section class="statement section-pad">
        <p class="section-kicker">01 / Profile</p>
        <div class="statement-grid">
          <h2>Engineering depth,<br /><em>research curiosity.</em></h2>
          <div class="statement-copy">
            <p>
              My work sits where product engineering, infrastructure, and applied research meet. I move
              comfortably from interfaces and APIs to developer tools, automation, and analytical models.
            </p>
            <p>
              At Uzhhorod National University, I combine postgraduate research with teaching support in the
              Department of Software Systems. My research focuses on AI, fuzzy models, and decision support for tourism.
            </p>
          </div>
        </div>
        <div class="capability-list" aria-label="Areas of expertise">
          {capabilities.map((capability, index) => (
            <span><b>{String(index + 1).padStart(2, "0")}</b>{capability}</span>
          ))}
        </div>
      </section>

      <section class="work section-pad" id="work">
        <div class="section-heading">
          <div>
            <p class="section-kicker light">02 / Selected work</p>
            <h2>Built to be used.</h2>
          </div>
          <p>A small selection from a broad public body of work—research software, AI experiments, secure tools, and open source.</p>
        </div>
        <div class="project-list">
          {projects.map((project) => (
            <a class="project-row" href={project.href} target="_blank" rel="noreferrer">
              <span class="project-index">{project.index}</span>
              <h3>{project.name}</h3>
              <p>{project.description}</p>
              <span class="project-stack">{project.stack}</span>
              <span class="project-arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </section>

      <section class="research section-pad" id="research">
        <div class="research-lead">
          <p class="section-kicker">03 / Research</p>
          <h2>Intelligence for better decisions.</h2>
          <p>
            My academic work explores how neural and fuzzy systems can model uncertainty, assess risk,
            and support more informed choices in tourism.
          </p>
          <a class="text-link" href="https://orcid.org/0009-0004-2445-8232" target="_blank" rel="noreferrer">
            Full ORCID record <span aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="publication-list">
          {publications.map((publication) => (
            <a href={publication.href} target="_blank" rel="noreferrer" class="publication">
              <span>{publication.year}</span>
              <div>
                <h3>{publication.title}</h3>
                <p>{publication.journal}</p>
              </div>
              <span class="publication-arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </section>

      <section class="connect section-pad" id="connect">
        <div class="connect-main">
          <p class="section-kicker light">04 / Connect</p>
          <h2>Have an interesting problem?</h2>
          <p>
            I&apos;m always interested in ambitious products, intelligent systems, and collaborations where thoughtful engineering matters.
          </p>
          <div class="contact-actions">
            <a class="button button-accent" href="mailto:andreyshafar@gmail.com">Start a conversation <span aria-hidden="true">↗</span></a>
            <a href="mailto:andrii.shafar@uzhnu.edu.ua" class="academic-email">Academic email</a>
          </div>
        </div>
        <div class="social-grid" aria-label="Social profiles">
          {socialLinks.map((social) => (
            <a href={social.href} target="_blank" rel="noreferrer">
              <span>{social.label}</span>
              <strong>{social.handle}</strong>
              <b aria-hidden="true">↗</b>
            </a>
          ))}
        </div>
        <footer>
          <span>© 2026 Andrii Shafar</span>
          <span>Engineered with intent.</span>
          <a href="#top">Back to top ↑</a>
        </footer>
      </section>
    </main>
</Layout>
