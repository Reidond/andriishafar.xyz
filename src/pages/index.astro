---
import Layout from "../layouts/Layout.astro";
import resume from "../data/resume.json";

const { profile, experience, education, projects, publications, socialLinks } = resume;

const formatPeriod = (period: string) => period.replace(/\s*-\s*Present$/, " – now");

type Job = {
  name: string;
  tagline: string;
  years: string;
  summary: string;
  highlights: string[];
  technologies: string[];
};

const work: Job[] = [
  ...[...experience]
    .sort((a, b) => Number(b.period.endsWith("Present")) - Number(a.period.endsWith("Present")))
    .map((item) => ({
      name: item.company,
      tagline: item.tagline,
      years: formatPeriod(item.period),
      summary: item.summary,
      highlights: item.highlights,
      technologies: item.technologies,
    })),
  {
    name: education.institution,
    tagline: education.tagline,
    years: "",
    summary: education.description,
    highlights: [],
    technologies: [],
  },
];

const links = socialLinks.filter((link) => ["GitHub", "Bluesky", "X", "ORCID"].includes(link.label));
const githubUrl = socialLinks.find((link) => link.label === "GitHub")?.href;
---

<Layout
  title="Andrii Shafar — Software Engineer & Applied Researcher"
  description="Andrii Shafar is a software engineer and applied researcher in Ukraine, building product systems and studying fuzzy and neural models for decision support."
>
  <header class="bar">
    <a class="bar-mark" href="#top" aria-label="Andrii Shafar, back to top">AS</a>
    <nav aria-label="Primary">
      <a href={`mailto:${profile.email}`}>Email</a>
      <a href={githubUrl} target="_blank" rel="noreferrer">GitHub</a>
      <a href="/andrii-shafar-resume.pdf" download>Résumé</a>
    </nav>
  </header>

  <main id="top">
    <section class="hero">
      <div class="hero-text">
        <h1>
          <span class="line"><span>Andrii</span></span>
          <span class="line"><span>Shafar</span></span>
        </h1>
        <p class="lede">Software engineer and applied researcher, {profile.location}.</p>
      </div>

      <figure class="portrait">
        <div class="portrait-frame" data-portrait>
          <img src="/andrii-shafar.jpg" alt={profile.name} width="460" height="460" />
          <span class="crosshair crosshair-x" aria-hidden="true" data-crosshair-x></span>
          <span class="crosshair crosshair-y" aria-hidden="true" data-crosshair-y></span>
        </div>
        <figcaption>
          <span data-readout aria-hidden="true">x 000 · y 000</span>
          <span>Fig. 1</span>
        </figcaption>
      </figure>
    </section>

    <section class="index" aria-label="Résumé">
      <div class="group">
        <h2>Work</h2>
        <ul>
          {work.map((item, index) => (
            <li class="job">
              {item.highlights.length > 0 ? (
                <button class="row job-head" type="button" aria-expanded="false" aria-controls={`job-${index}`} data-job>
                  <span class="row-main">{item.name}</span>
                  <span class="row-sub">{item.tagline}</span>
                  <span class="row-end">
                    {item.years}
                    <svg class="job-icon" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M8 3.5v9M3.5 8h9" /></svg>
                  </span>
                </button>
              ) : (
                <div class="row job-head">
                  <span class="row-main">{item.name}</span>
                  <span class="row-sub">{item.tagline}</span>
                  <span class="row-end">{item.years}</span>
                </div>
              )}
              <p class="job-summary">{item.summary}</p>
              {item.highlights.length > 0 && (
                <div class="job-more" id={`job-${index}`}>
                  <div class="job-more-inner">
                    <ul class="job-highlights">
                      {item.highlights.map((highlight) => <li>{highlight}</li>)}
                    </ul>
                    <p class="job-tech">{item.technologies.join(" · ")}</p>
                  </div>
                </div>
              )}
            </li>
          ))}
        </ul>
      </div>

      <div class="group">
        <h2>Projects</h2>
        <ul>
          {projects.map((project) => (
            <li>
              <a class="row" href={project.href} target="_blank" rel="noreferrer">
                <span class="row-main">{project.name}</span>
                <span class="row-sub">{project.tagline}</span>
                <span class="row-end" aria-hidden="true">
                  <svg viewBox="0 0 16 16" width="16" height="16"><path d="M5 11 11 5M6 5h5v5" /></svg>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="group">
        <h2>Papers</h2>
        <ul>
          {publications.map((paper) => (
            <li>
              <a class="row row-paper" href={paper.href} target="_blank" rel="noreferrer">
                <span class="row-main">{paper.title}</span>
                <span class="row-end">{paper.year}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="group">
        <h2>Contact</h2>
        <div class="contact">
          <button class="email" type="button" data-copy={profile.email}>
            <span>{profile.email}</span>
            <span class="email-icon" aria-hidden="true">
              <svg class="icon-copy" viewBox="0 0 16 16" width="16" height="16">
                <rect x="5.5" y="5.5" width="8" height="8" rx="1.5" />
                <path d="M10.5 3.5v-.5A1.5 1.5 0 0 0 9 1.5H4A1.5 1.5 0 0 0 2.5 3v5A1.5 1.5 0 0 0 4 9.5h.5" />
              </svg>
              <svg class="icon-check" viewBox="0 0 16 16" width="16" height="16"><path d="m3.5 8.5 3 3 6-7" /></svg>
            </span>
          </button>
          <span class="sr-only" aria-live="polite" data-status></span>
          <div class="links">
            {links.map((link) => (
              <a href={link.href} target="_blank" rel="noreferrer">{link.label}</a>
            ))}
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  const frame = document.querySelector<HTMLElement>("[data-portrait]")!;
  const lineX = document.querySelector<HTMLElement>("[data-crosshair-x]")!;
  const lineY = document.querySelector<HTMLElement>("[data-crosshair-y]")!;
  const readout = document.querySelector<HTMLElement>("[data-readout]")!;
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Crosshair follows the pointer over the portrait with a little lag, like a measuring tool.
  const pointer = { x: 0, y: 0, tx: 0, ty: 0 };
  let frameId = 0;

  function draw() {
    pointer.x += (pointer.tx - pointer.x) * (reduceMotion ? 1 : 0.22);
    pointer.y += (pointer.ty - pointer.y) * (reduceMotion ? 1 : 0.22);
    lineX.style.transform = `translateY(${pointer.y}px)`;
    lineY.style.transform = `translateX(${pointer.x}px)`;
    const settled = Math.abs(pointer.tx - pointer.x) < 0.1 && Math.abs(pointer.ty - pointer.y) < 0.1;
    frameId = settled ? 0 : requestAnimationFrame(draw);
  }

  frame.addEventListener("pointerenter", (event) => {
    const rect = frame.getBoundingClientRect();
    pointer.x = pointer.tx = event.clientX - rect.left;
    pointer.y = pointer.ty = event.clientY - rect.top;
    draw();
  });

  frame.addEventListener("pointermove", (event) => {
    const rect = frame.getBoundingClientRect();
    pointer.tx = Math.min(rect.width, Math.max(0, event.clientX - rect.left));
    pointer.ty = Math.min(rect.height, Math.max(0, event.clientY - rect.top));
    const x = Math.round((pointer.tx / rect.width) * 460);
    const y = Math.round((pointer.ty / rect.height) * 460);
    readout.textContent = `x ${String(x).padStart(3, "0")} · y ${String(y).padStart(3, "0")}`;
    if (!frameId) frameId = requestAnimationFrame(draw);
  });

  document.querySelectorAll<HTMLButtonElement>("[data-job]").forEach((button) => {
    const panel = document.getElementById(button.getAttribute("aria-controls")!)!;
    panel.inert = true;
    button.addEventListener("click", () => {
      const open = button.getAttribute("aria-expanded") !== "true";
      button.setAttribute("aria-expanded", String(open));
      panel.inert = !open;
    });
  });

  const email = document.querySelector<HTMLButtonElement>("[data-copy]")!;
  const status = document.querySelector<HTMLElement>("[data-status]")!;
  let reset = 0;

  email.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(email.dataset.copy!);
    } catch {
      window.location.href = `mailto:${email.dataset.copy}`;
      return;
    }
    email.setAttribute("data-copied", "");
    status.textContent = "Email copied";
    clearTimeout(reset);
    reset = window.setTimeout(() => {
      email.removeAttribute("data-copied");
      status.textContent = "";
    }, 1600);
  });
</script>
