---
import Layout from "../layouts/Layout.astro";
import resume from "../data/resume.json";

const {
  profile,
  audit,
  metrics,
  capabilities,
  experience,
  projects,
  education,
  publications,
  socialLinks,
} = resume;

---

<Layout
  title="Andrii Shafar — Software Engineer & Applied Researcher"
  description="The professional résumé of Andrii Shafar: six years of product engineering across Charidy, Lemmi, and SapienLabs, plus open-source work and applied AI research."
>
    <main>
      <nav class="site-nav" aria-label="Primary navigation">
        <a class="wordmark" href="#top" aria-label="Andrii Shafar, home">
          AS<span class="wordmark-dot">.</span>
        </a>
        <div class="nav-links">
          <a href="#experience">Experience</a>
          <a href="#work">Projects</a>
          <a href="#research">Research</a>
        </div>
        <a class="nav-cta" href="/andrii-shafar-resume.pdf" download>
          Résumé PDF <span aria-hidden="true">↓</span>
        </a>
      </nav>

      <section class="hero" id="top">
        <div class="hero-intro">
          <p class="eyebrow"><span class="status-dot" /> Based in {profile.location} - Open to meaningful work</p>
          <h1>
            Software engineer.
            <br />
            Applied researcher.
            <br />
            <span>System thinker.</span>
          </h1>
          <p class="hero-copy">
            I&apos;m {profile.name}. {profile.summary}
          </p>
          <div class="hero-actions">
            <a class="button button-dark" href="#experience">Explore experience <span aria-hidden="true">↓</span></a>
            <a class="text-link" href="/andrii-shafar-resume.pdf" download>
              Download résumé <span aria-hidden="true">↓</span>
            </a>
          </div>
        </div>

        <div class="portrait-wrap">
          <div class="portrait-frame">
            <img src="/andrii-shafar.jpg" alt="Andrii Shafar" />
          <div class="portrait-caption">
              <span>{profile.name}</span>
              <span>Engineer / Researcher</span>
            </div>
          </div>
          <div class="portrait-note" aria-hidden="true">
            <span>BUILD</span>
            <span>RESEARCH</span>
            <span>REFINE</span>
          </div>
        </div>

        <div class="hero-metrics" role="list" aria-label="Professional highlights">
          {metrics.map((metric) => (
            <div role="listitem"><strong>{metric.value}</strong><span>{metric.label}</span></div>
          ))}
        </div>
      </section>

      <section class="statement section-pad">
        <p class="section-kicker">01 / Profile</p>
        <div class="statement-grid">
          <h2>Engineering depth,<br /><em>research curiosity.</em></h2>
          <div class="statement-copy">
            <p>
              My work sits where product engineering, infrastructure, and applied research meet. I move
              comfortably from interfaces and APIs to developer tools, automation, and analytical models.
            </p>
            <p>
              At {education.institution}, I combine postgraduate research with teaching support. {education.description}
            </p>
          </div>
        </div>
        <div class="capability-list" role="list" aria-label="Areas of expertise">
          {capabilities.map((capability, index) => (
            <span role="listitem"><b>{String(index + 1).padStart(2, "0")}</b>{capability}</span>
          ))}
        </div>
      </section>

      <section class="experience section-pad" id="experience">
        <div class="experience-heading">
          <div>
            <p class="section-kicker">02 / Professional experience</p>
            <h2>Systems that carry real work.</h2>
          </div>
          <div class="audit-note">
            <p>{audit.summary}</p>
            <span>{audit.note}</span>
          </div>
        </div>
        <div class="experience-list">
          {experience.map((item, index) => (
            <article class="experience-item">
              <div class="experience-meta">
                <span>{String(index + 1).padStart(2, "0")}</span>
                <p>{item.period}</p>
              </div>
              <div class="experience-content">
                <header>
                  <h3>{item.company}</h3>
                  <p>{item.scope}</p>
                </header>
                <p class="experience-summary">{item.summary}</p>
                <ul>
                  {item.highlights.map((highlight) => <li>{highlight}</li>)}
                </ul>
                <div class="experience-tech" role="list" aria-label={`${item.company} technologies`}>
                  {item.technologies.map((technology) => <span role="listitem">{technology}</span>)}
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="work section-pad" id="work">
        <div class="section-heading">
          <div>
            <p class="section-kicker light">03 / Selected projects</p>
            <h2>Built to be used.</h2>
          </div>
          <p>A small selection from a broad public body of work - research software, AI experiments, secure tools, and open source.</p>
        </div>
        <div class="project-list">
          {projects.map((project) => (
            <a class="project-row" href={project.href} target="_blank" rel="noreferrer">
              <span class="project-index">{project.index}</span>
              <h3>{project.name}</h3>
              <p>{project.description}</p>
              <span class="project-stack">{project.stack}</span>
              <span class="project-arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </section>

      <section class="research section-pad" id="research">
        <div class="research-lead">
          <p class="section-kicker">04 / Research</p>
          <h2>Intelligence for better decisions.</h2>
          <p>
            My academic work explores how neural and fuzzy systems can model uncertainty, assess risk,
            and support more informed choices in tourism.
          </p>
          <a class="text-link" href="https://orcid.org/0009-0004-2445-8232" target="_blank" rel="noreferrer">
            Full ORCID record <span aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="publication-list">
          {publications.map((publication) => (
            <a href={publication.href} target="_blank" rel="noreferrer" class="publication">
              <span>{publication.year}</span>
              <div>
                <h3>{publication.title}</h3>
                <p>{publication.journal}</p>
              </div>
              <span class="publication-arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </section>

      <section class="connect section-pad" id="connect">
        <div class="connect-main">
          <p class="section-kicker light">05 / Connect</p>
          <h2>Have an interesting problem?</h2>
          <p>
            I&apos;m always interested in ambitious products, intelligent systems, and collaborations where thoughtful engineering matters.
          </p>
          <div class="contact-actions">
            <a class="button button-accent" href={`mailto:${profile.email}`}>Start a conversation <span aria-hidden="true">↗</span></a>
            <a href={`mailto:${profile.academicEmail}`} class="academic-email">Academic email</a>
          </div>
        </div>
        <nav class="social-grid" aria-label="Social profiles">
          {socialLinks.map((social) => (
            <a href={social.href} target="_blank" rel="noreferrer">
              <span>{social.label}</span>
              <strong>{social.handle}</strong>
              <b aria-hidden="true">↗</b>
            </a>
          ))}
        </nav>
        <footer>
          <span>© 2026 Andrii Shafar</span>
          <span>Engineered with intent.</span>
          <a href="#top">Back to top ↑</a>
        </footer>
      </section>
    </main>
</Layout>
